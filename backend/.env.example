# NestJS development port
PORT=4000
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000
# PostgreSQL connection string configured by TV2
DATABASE_URL="postgresql://postgres:password@localhost:5432/brewlite_db?schema=public"
# Generate a private JWT key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the generated value in backend/.env; never commit the real key.
JWT_SECRET=
