# NestJS development port
PORT=4000
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000
# PostgreSQL connection string configured by TV2
DATABASE_URL="postgresql://postgres:123456@localhost:5432/brewlite_db?schema=public"
# Generate a private JWT key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the generated value in backend/.env; never commit the real key.
JWT_SECRET=

# Live payOS configuration (for running Backend outside Docker).
PAYMENT_MODE=mock
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_BASE_URL=https://your-brewlite-site.example
PAYOS_ORDER_CODE_PREFIX=260000000

# TV3: keep TTL unchanged while pending orders exist.
ORDER_PAYMENT_TTL_MINUTES=15
ORDER_EXPIRY_WORKER_ENABLED=true
