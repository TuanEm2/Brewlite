generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

/// Tất cả tồn kho và định lượng dùng đơn vị gốc: gram, milliliter hoặc cái.
enum IngredientUnit {
  G
  ML
  PIECE
}

enum RecipeSize {
  S
  M
  L
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  orders        Order[]
}

/// Sản phẩm trong menu. Mọi số tiền tính bằng VND (số nguyên).
model Product {
  id          Int                 @id @default(autoincrement())
  name        String
  /// Giá gốc, ứng với size S và không chọn topping.
  price       Int
  imageUrl    String
  /// Số lượng tồn kho.
  stock       Int                 @default(100)
  /// Tăng thêm 1 mỗi lần cập nhật tồn kho; dùng làm điều kiện `where: { id, version }` khi trừ kho (optimistic locking, Task 10).
  version     Int                 @default(0)
  /// Danh sách size, ví dụ [{ "name": "S", "price": 0 }]. `price` là phụ thu cộng vào giá gốc.
  sizes       Json
  /// Danh sách topping, ví dụ [{ "name": "Trân châu", "price": 5000 }]. `price` là phụ thu của mỗi topping.
  toppings    Json
  orderItems  OrderItem[]
  ingredients ProductIngredient[]
}

/// Đơn hàng (Task 6). Mọi số tiền tính bằng VND (số nguyên).
model Order {
  id                Int              @id @default(autoincrement())
  /// Để trống được cho tới khi có Auth (Task 7); route đặt đơn sẽ bắt buộc đăng nhập bằng guard.
  userId            Int?
  status            OrderStatus      @default(PENDING)
  /// Số tiền phải trả = tổng các `OrderItem.lineTotal` − `discount`.
  total             Int
  /// Giảm giá từ voucher (Task 10, TV5).
  discount          Int              @default(0)
  voucherCode       String?
  /// Khóa chống tạo đơn trùng (Task 10, TV1).
  idempotencyKey    String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  user              User?            @relation(fields: [userId], references: [id])
  items             OrderItem[]
  payment           Payment?
  paymentAttempts   PaymentAttempt[]
  ingredientUsages  OrderIngredient[]

  
}

/// Kho nguyên liệu dùng chung giữa các sản phẩm. Decimal tránh sai số khi trừ kho.
model Ingredient {
  id          Int                 @id @default(autoincrement())
  code        String              @unique
  name        String
  unit        IngredientUnit
  stock       Decimal             @default(0) @db.Decimal(14, 3)
  version     Int                 @default(0)
  recipes     ProductIngredient[]
  orderUsages OrderIngredient[]

  // Ràng buộc tầng database: chặn tồn kho âm, version âm
  
  @@index([code])
}

/// Định lượng cho MỘT ly của đúng size. topping rỗng là công thức nền;
/// topping có tên là phần cộng thêm khi khách chọn topping đó.
model ProductIngredient {
  id           Int         @id @default(autoincrement())
  productId    Int
  ingredientId Int
  size         RecipeSize
  topping      String      @default("")
  quantity     Decimal     @db.Decimal(12, 3)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  // Ràng buộc tầng database: chặn định lượng bằng 0 hoặc âm
  
  @@unique([productId, ingredientId, size, topping])
  @@index([ingredientId])
}

/// Snapshot tổng nguyên liệu đã giữ/trừ cho đơn. TV4 ghi cùng transaction tạo đơn,
/// dùng snapshot khi hủy để hoàn đúng lượng cũ dù công thức sản phẩm đã thay đổi.
model OrderIngredient {
  orderId      Int
  ingredientId Int
  quantity     Decimal     @db.Decimal(14, 3)
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([orderId, ingredientId])
  @@index([ingredientId])
}

/// Một dòng trong đơn. Lưu giá và lựa chọn tại thời điểm đặt, không phụ thuộc giá sản phẩm sau này.
model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  size        String
  /// Topping đã chọn kèm phụ thu, ví dụ [{ "name": "Kem", "price": 10000 }].
  toppings    Json    @default("[]")
  qty         Int
  /// Đơn giá = giá gốc + phụ thu size + tổng phụ thu topping.
  unitPrice   Int
  /// unitPrice × qty.
  lineTotal   Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  
}

model Payment {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique
  idempotencyKey String   @unique
  amount         Int
  method         String
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Ghi cả các lần thanh toán mô phỏng thành công và thất bại,
/// bảo đảm một idempotencyKey chỉ được xử lý một lần.
model PaymentAttempt {
  id             Int      @id @default(autoincrement())
  orderId        Int
  idempotencyKey String   @unique
  amount         Int
  method         String
  outcome        String
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}