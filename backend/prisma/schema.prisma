generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  orders        Order[]
}

/// Sản phẩm trong menu. Mọi số tiền tính bằng VND (số nguyên).
model Product {
  id         Int         @id @default(autoincrement())
  name       String
  /// Giá gốc, ứng với size S và không chọn topping.
  price      Int
  imageUrl   String
  /// Số lượng tồn kho.
  stock      Int         @default(100)
  /// Tăng thêm 1 mỗi lần cập nhật tồn kho; dùng làm điều kiện `where: { id, version }` khi trừ kho (optimistic locking, Task 10).
  version    Int         @default(0)
  /// Danh sách size, ví dụ [{ "name": "S", "price": 0 }]. `price` là phụ thu cộng vào giá gốc.
  sizes      Json
  /// Danh sách topping, ví dụ [{ "name": "Trân châu", "price": 5000 }]. `price` là phụ thu của mỗi topping.
  toppings   Json
  orderItems OrderItem[]
}

/// Đơn hàng (Task 6). Mọi số tiền tính bằng VND (số nguyên).
model Order {
  id             Int         @id @default(autoincrement())
  /// Để trống được cho tới khi có Auth (Task 7); route đặt đơn sẽ bắt buộc đăng nhập bằng guard.
  userId         Int?
  status         OrderStatus @default(PENDING)
  /// Số tiền phải trả = tổng các `OrderItem.lineTotal` − `discount`.
  total          Int
  /// Giảm giá từ voucher (Task 10, TV5).
  discount       Int         @default(0)
  voucherCode    String?
  /// Khóa chống tạo đơn trùng (Task 10, TV1).
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  user           User?       @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payment        Payment?
}

/// Một dòng trong đơn. Lưu giá và lựa chọn tại thời điểm đặt, không phụ thuộc giá sản phẩm sau này.
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  size      String
  /// Topping đã chọn kèm phụ thu, ví dụ [{ "name": "Kem", "price": 10000 }].
  toppings  Json    @default("[]")
  qty       Int
  /// Đơn giá = giá gốc + phụ thu size + tổng phụ thu topping.
  unitPrice Int
  /// unitPrice × qty.
  lineTotal Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique
  idempotencyKey String   @unique
  amount         Int
  method         String
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
