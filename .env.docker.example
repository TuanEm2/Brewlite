# Copy to .env in the repository root before `docker compose up --build`.
# LOCAL DEMO ONLY: choose a URL-safe password (letters, digits, - or _).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-db-password
POSTGRES_DB=brewlite
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_AT_LEAST_32_CHARACTER_SECRET

# Real payment: enable only after merchant account verification and public HTTPS setup.
PAYMENT_MODE=mock
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# HTTPS site URL. Must not be localhost for a deployed merchant.
PAYOS_RETURN_BASE_URL=https://your-brewlite-site.example
# Merchant-unique numeric prefix; keep unchanged once checkout records exist.
PAYOS_ORDER_CODE_PREFIX=260000000
