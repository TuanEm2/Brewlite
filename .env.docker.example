# Copy to .env in the repository root before `docker compose up --build`.
# LOCAL DEMO ONLY: choose a URL-safe password (letters, digits, - or _).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-db-password
POSTGRES_DB=brewlite
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_AT_LEAST_32_CHARACTER_SECRET
